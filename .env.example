# Copy to .env and fill in. Never commit real values.
TG_API_ID=
TG_API_HASH=
TG_BOT_TOKEN=
# Comma-separated group chat IDs (e.g. -1001234567890). Empty = all groups.
ALLOWED_GROUPS=
# Comma-separated Telegram user IDs allowed to /addnote in every group.
ADMIN_IDS=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
DB_PATH=rag_bot.db
